{% import "tree" as tree %}
<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <link rel="icon" href="/static/small_birb.svg" type="image/svg">
  <title>Marungu Sunbird</title>
  
  <meta property="og:title" content="Marungu Sunbird">
  <meta property="og:site_name" content="Marungu Sunbird">
  <meta property="og:description" content="A simple rusty TeamSpeak server augmentation.">
  <meta property="og:image" content="/static/big_birb.svg">
  <meta property="og:image:alt" content="A rare and endangered nectar-feeding bird that is only found in a small forest in the Marungu highlands of Congo. It has a long, decurved black bill and is mainly green with a blue tail and a yellow belly.">
  <meta property="og:type" content="website">
  
  <link rel="stylesheet" href="/static/css/default.css">
  <link rel="stylesheet" href="/static/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/twemoji/dist/twemoji.min.js"></script>
  <script>
    window.onload = () => {
      twemoji.parse(document.body, {
        folder: 'svg',
        ext: '.svg'
      });
    }
  </script>
  {{ tree::tree_header() }}
</head>

<body>
  <div id="wrapper">
    {% if connected is defined and not connected %}
    <div id="disconnected-banner" role="alert">
      ⚠ Disconnected from the TeamSpeak server — attempting to reconnect…
    </div>
    {% endif %}
    <header>
      <h1><img src="/static/small_birb.svg" />Marungu Sunbird</h1>
    </header>
    <div id="content">
      <div id="tree">
        {% if tree is defined and tree %}
        {{ tree::tree(tree=tree) }}
        {% endif %}
      </div>
      <div id="sidepanel">
        {% block properties %}
        <p class="h1 center">{{ name }}</p>
        <div id="properties">
          {% for prop in properties %}
            <div class="property">
              <span class="name">{{ prop.name }}:</span>
              {% set value = prop.value | default(value="None") | as_str %}
              <span class="value{% if value == "None" %} none{% endif %}">{{ value }}</span>
            </div>
          {% endfor %}
        </div>
        {% endblock %}
      </div>
    </div>
  </div>
  <script>
    // Live updates over a WebSocket: keeps the tree fresh and toggles the
    // disconnected banner without polling. Reconnects the socket if it drops.
    (function () {
      const BANNER_ID = "disconnected-banner";
      const MESSAGE = "⚠ Disconnected from the TeamSpeak server — attempting to reconnect…";

      function setBanner(connected) {
        let banner = document.getElementById(BANNER_ID);
        if (!connected && !banner) {
          banner = document.createElement("div");
          banner.id = BANNER_ID;
          banner.setAttribute("role", "alert");
          banner.textContent = MESSAGE;
          document.getElementById("wrapper").prepend(banner);
        } else if (connected && banner) {
          banner.remove();
        }
      }

      function applyTree(html) {
        const tree = document.getElementById("tree");
        if (!tree) return;
        tree.innerHTML = html;
        if (window.twemoji) {
          twemoji.parse(tree, { folder: "svg", ext: ".svg" });
        }
      }

      let socket;
      function connect() {
        const proto = location.protocol === "https:" ? "wss:" : "ws:";
        socket = new WebSocket(proto + "//" + location.host + "/ws");
        socket.onmessage = (ev) => {
          let data;
          try {
            data = JSON.parse(ev.data);
          } catch (e) {
            return;
          }
          setBanner(data.connected);
          if (data.connected && typeof data.tree_html === "string") {
            applyTree(data.tree_html);
          }
        };
        socket.onclose = () => {
          // Web server itself went away — show the banner and retry the socket.
          setBanner(false);
          setTimeout(connect, 3000);
        };
        socket.onerror = () => socket.close();
      }
      connect();
    })();
  </script>
</body>

</html>